@using Data.Models;
@model List<Person>

<table class="table table-hover table-bordered">
    <caption>People Table</caption>
    <thead>
        <th>ID</th>
        <th>Full Name</th>
        <th>National Numver</th>
        <th>Birth Date</th>
        <th>Gender</th>
        <th>Phone</th>
        <th>Email</th>
        <th>Country</th>
        <th>Address</th>
        <th>Image</th>
        <th>Actions</th>
    </thead>
    <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>@item.ID</td>
                <td>@($"{item.FirstName} {item.SecondName} {item.ThirdName} {item.LastName}")</td>
                <td>@item.NationalNumber</td>
                <td>@item.BirthDate</td>
                <td>@(item.Gender == Data.Models.Enums.Gender.Male ? "Male" : "Female")</td>
                <td>@item.Phone</td>
                <td>@item.Email</td>
                <td>@item.Country</td>
                <td>@item.Address</td>
                <td>@item.ImageRelativePath</td>
                <td>
                    <a asp-controller="People" asp-action="Update" asp-route-id="@item.ID" class="btn btn-primary">Update</a>
                    <a asp-controller="People" asp-action="Delete" asp-route-id="@item.ID" class="btn btn-primary">Delete</a>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <a asp-action="AddNew" asp-controller="People" class="btn btn-primary">Add New Person</a>
        </tr>        
    </tfoot>
</table> 